<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flexiv_amr_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch and configuration for the Flexiv AMR ROS 2 stack.</description>
  <maintainer email="mingchen.cai@flexiv.com">cmc</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>flexiv_amr_description</exec_depend>
  <exec_depend>flexiv_amr_driver</exec_depend>
  <exec_depend>flexiv_amr_imu</exec_depend>
  <exec_depend>flexiv_amr_navigation</exec_depend>
  <exec_depend>flexiv_amr_sensor</exec_depend>
  <exec_depend>flexiv_amr_wheel_odom</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_localization</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
